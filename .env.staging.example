# Staging Environment Variables Template
# Copy to .env.staging on the staging server and replace placeholders with real values.
# localhost and 127.0.0.1 are not allowed in staging.

NODE_ENV=staging
PORT=8081

DATABASE_URL=postgresql://user:password@db.staging.internal:5432/audiobook_staging
SESSION_SECRET=

REDIS_URL=redis://redis.staging.internal:6379
RABBITMQ_URL=amqp://user:password@rabbitmq.staging.internal:5672
RABBITMQ_QUEUE_PREFIX=audiobook

MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

STORAGE_PROVIDER=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
STREAMING_SERVICE_STORAGE_PATH=
STREAMING_SERVICE_URL=https://streaming.staging.internal/api/v1/stream

AUTH_SERVICE_URL=https://auth.staging.internal
JWKS_ENDPOINT=https://auth.staging.internal/auth/.well-known/jwks.json

LOG_LEVEL=info
LOG_DIR=./logs

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AudioBookApp/1.0 (profile-location-resolver)
