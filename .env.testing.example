# Testing server environment (deployed test environment)
# Copy to .env.testing on the test server. localhost is allowed.
# NODE_ENV=testing is separate from Jest (NODE_ENV=test).

NODE_ENV=testing
PORT=8081

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiobook_dev
SESSION_SECRET=

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=audiobook

MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

STORAGE_PROVIDER=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600

TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
STREAMING_SERVICE_STORAGE_PATH=
STREAMING_SERVICE_URL=http://localhost:8083/api/v1/stream

AUTH_SERVICE_URL=http://localhost:8080
JWKS_ENDPOINT=http://localhost:8080/auth/.well-known/jwks.json

LOG_LEVEL=info
LOG_DIR=./logs

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AudioBookApp/1.0 (profile-location-resolver)
