# Production Environment Variables Template
# Copy to .env.production on the production server and replace placeholders with real values.
# localhost and 127.0.0.1 are not allowed in production.

NODE_ENV=production
PORT=8081

DATABASE_URL=postgresql://user:password@db.production.internal:5432/audiobook_production
SESSION_SECRET=

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

REDIS_URL=redis://redis.production.internal:6379
RABBITMQ_URL=amqp://user:password@rabbitmq.production.internal:5672
RABBITMQ_QUEUE_PREFIX=audiobook

MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

STORAGE_PROVIDER=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600

TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
STREAMING_SERVICE_STORAGE_PATH=
STREAMING_SERVICE_URL=https://streaming.production.internal/api/v1/stream

AUTH_SERVICE_URL=https://auth.production.internal
JWKS_ENDPOINT=https://auth.production.internal/auth/.well-known/jwks.json

LOG_LEVEL=warn
LOG_DIR=./logs

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AudioBookApp/1.0 (profile-location-resolver)
