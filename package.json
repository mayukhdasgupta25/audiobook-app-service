    "db:migrate:testing": "NODE_ENV=testing node scripts/prisma-env.js migrate dev",
    "db:migrate:staging": "NODE_ENV=staging node scripts/prisma-env.js migrate dev",
    "db:migrate:production": "NODE_ENV=production node scripts/prisma-env.js migrate dev",
    "db:migrate:deploy:testing": "NODE_ENV=testing node scripts/prisma-env.js migrate deploy",
